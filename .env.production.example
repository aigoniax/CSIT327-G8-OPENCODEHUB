# Production Environment Variables for Render
# Copy these to your Render dashboard under Environment Variables

# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com

# Database (PostgreSQL)
# Get this from Supabase or Render PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Example Supabase URL format:
# DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-x-xx-xxxxx-x.pooler.supabase.com:5432/postgres

# Python Version (for Render)
PYTHON_VERSION=3.11.0
